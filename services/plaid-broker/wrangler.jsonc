{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-map-plaid-broker",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "vars": { "APP_ENVIRONMENT": "sandbox" },
  "d1_databases": [
    {
      "binding": "BROKER_DB",
      "database_name": "money-map-plaid-broker",
      "database_id": "ac6d1839-e5ef-4cf4-b93c-99ef5d15174a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
