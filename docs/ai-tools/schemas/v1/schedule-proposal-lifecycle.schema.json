{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://money-map.local/schemas/ai-tools/v1/schedule-proposal-lifecycle.schema.json",
  "title": "Schedule proposal lifecycle v1",
  "oneOf": [
    { "$ref": "#/$defs/CreateRequest" },
    { "$ref": "#/$defs/TransitionRequest" },
    { "$ref": "#/$defs/ConfirmRequest" },
    { "$ref": "#/$defs/ExecuteRequest" },
    { "$ref": "#/$defs/LifecycleResult" },
    { "$ref": "#/$defs/ConfirmationArtifact" }
  ],
  "$defs": {
    "State": {
      "enum": ["proposed", "approved", "rejected", "expired", "stale", "executed", "failed"]
    },
    "Precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordRef", "expectedVersion"],
      "properties": {
        "recordRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "expectedVersion": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role"],
      "properties": {
        "ref": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "role": { "enum": ["observation", "statement", "derived", "user_assertion", "external_citation"] },
        "observedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "ScheduleEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "targetScheduleRef", "name", "accountRef", "direction", "amount", "amountPolicy", "cadence", "temporalRole", "startDate", "endDate"],
      "properties": {
        "operation": { "enum": ["schedule.create", "schedule.update"] },
        "targetScheduleRef": {
          "anyOf": [
            { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
            { "type": "null" }
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "accountRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "direction": { "enum": ["inflow", "outflow"] },
        "amount": { "$ref": "capability-envelope.schema.json#/$defs/Money" },
        "amountPolicy": { "enum": ["fixed", "estimate", "statement_amount", "variable"] },
        "cadence": { "enum": ["daily", "weekly", "biweekly", "monthly", "quarterly", "annual"] },
        "temporalRole": { "enum": ["due_date", "planned_date", "autopay_date", "expected_settlement_date"] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": ["string", "null"], "format": "date" }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "schedule.create" } }, "required": ["operation"] },
          "then": { "properties": { "targetScheduleRef": { "type": "null" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "schedule.update" } }, "required": ["operation"] },
          "then": { "properties": { "targetScheduleRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" } } }
        }
      ]
    },
    "ScheduleSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduleRef", "accountRef", "name", "amountCents", "recurrence", "startDate", "endDate", "active"],
      "properties": {
        "scheduleRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "accountRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "name": { "type": "string" },
        "amountCents": { "type": "integer" },
        "recurrence": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": ["string", "null"], "format": "date" },
        "active": { "type": "boolean" }
      }
    },
    "Proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalRef", "state", "createdByActorId", "createdByActorType", "before", "effect", "effectDigest", "evidence", "assumptions", "preconditions", "createdAt", "expiresAt", "createIdempotencyKey", "resultScheduleRef", "lastError"],
      "properties": {
        "proposalRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "state": { "$ref": "#/$defs/State" },
        "createdByActorId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdByActorType": { "enum": ["user", "in_app_harness", "local_mcp_client", "system"] },
        "before": {
          "anyOf": [
            { "$ref": "#/$defs/ScheduleSnapshot" },
            { "type": "null" }
          ]
        },
        "effect": { "$ref": "#/$defs/ScheduleEffect" },
        "effectDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EvidenceRef" } },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "preconditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Precondition" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createIdempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200 },
        "resultScheduleRef": {
          "anyOf": [
            { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
            { "type": "null" }
          ]
        },
        "lastError": { "type": ["string", "null"] }
      }
    },
    "ConfirmationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "proposalRef", "proposalVersion", "profileRef", "actorId", "effectDigest", "confirmedAt", "expiresAt"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 16, "maxLength": 500 },
        "proposalRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "proposalVersion": { "type": "string", "pattern": "^v[0-9]+$" },
        "profileRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "effectDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "evidence", "assumptions", "preconditions", "expiresAt", "idempotencyKey"],
      "properties": {
        "effect": { "$ref": "#/$defs/ScheduleEffect" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EvidenceRef" } },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/Precondition" } },
        "expiresAt": { "type": "string", "format": "date-time" },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200 }
      }
    },
    "TransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalRef", "expectedProposalVersion", "idempotencyKey", "reason"],
      "properties": {
        "proposalRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "expectedProposalVersion": { "type": "string", "pattern": "^v[0-9]+$" },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200 },
        "reason": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "ConfirmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalRef", "expectedProposalVersion"],
      "properties": {
        "proposalRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "expectedProposalVersion": { "type": "string", "pattern": "^v[0-9]+$" }
      }
    },
    "ExecuteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalRef", "expectedProposalVersion", "confirmationArtifact", "idempotencyKey"],
      "properties": {
        "proposalRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "expectedProposalVersion": { "type": "string", "pattern": "^v[0-9]+$" },
        "confirmationArtifact": { "$ref": "#/$defs/ConfirmationArtifact" },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200 }
      }
    },
    "LifecycleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "auditRef", "replayed"],
      "properties": {
        "proposal": { "$ref": "#/$defs/Proposal" },
        "auditRef": { "$ref": "capability-envelope.schema.json#/$defs/RecordRef" },
        "replayed": { "type": "boolean" }
      }
    }
  }
}
