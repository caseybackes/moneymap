{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Money Map",
  "version": "0.1.0",
  "identifier": "com.caseybackes.moneymap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Money Map",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
