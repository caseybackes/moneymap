{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Money Map",
  "version": "0.2.0",
  "identifier": "com.caseybackes.moneymap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Money Map",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.plaid.com/link/v2/stable/link-initialize.js; style-src 'self' 'unsafe-inline'; frame-src https://cdn.plaid.com; img-src 'self' data: https://cdn.plaid.com; connect-src 'self' https://money-map-plaid-broker-production.cloud-admin-f91.workers.dev https://production.plaid.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Money Map",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
